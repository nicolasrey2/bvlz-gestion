// Esquema Prisma — BVLZ Gestión de Destacamento
// Fase 0: entidades fundacionales. Los modelos operativos (Tarea, Guardia,
// Fichada, Novedad, ParteIntervencion) se agregan en fases posteriores.
// Ver docs/PRD.md y docs/TECH.md.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Jerarquía institucional (rango) de la persona. Atributo ~fijo del usuario,
/// independiente del rol funcional. Orden de menor a mayor.
enum Rango {
  ASPIRANTE
  BOMBERO
  CABO
  CABO_PRIMERO
  SARGENTO
  SARGENTO_PRIMERO
  SUBOFICIAL_PRINCIPAL
  SUBOFICIAL_MAYOR
  OFICIAL_AYUDANTE
  OFICIAL_INSPECTOR
  OFICIAL_PRINCIPAL
  SUBCOMANDANTE
  COMANDANTE
  SEGUNDO_JEFE_CUERPO
  JEFE_CUERPO
}

/// Rol funcional dentro del destacamento. Determina permisos. Rota en el tiempo.
enum RolTipo {
  ENCARGADO_INTERNO
  SUB_ENCARGADO
  ENCARGADO_AREA
  MIEMBRO
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

/// Entidad raíz. El MVP opera con un solo destacamento (Llavallol), pero el
/// modelo está preparado para multi-destacamento desde el inicio.
model Destacamento {
  id        String   @id @default(cuid())
  nombre    String
  cuartel   String? // ej. "Llavallol"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios Usuario[]
  areas    Area[]
  tareas   Tarea[]
  guardias Guardia[]

  @@map("destacamento")
}

/// Persona del destacamento. Los cuarteleros externos NO son usuarios en el MVP.
model Usuario {
  id             String   @id @default(cuid())
  /// UUID del usuario en Supabase Auth (fuente de verdad de la sesión).
  authId         String?  @unique
  email          String   @unique
  nombre         String
  apellido       String
  rango          Rango    @default(BOMBERO)
  legajo         String? // para partes de intervención
  dni            String?
  telefono       String?
  activo         Boolean  @default(true)
  destacamentoId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  destacamento    Destacamento    @relation(fields: [destacamentoId], references: [id])
  asignaciones    AsignacionRol[]
  tareasCreadas   Tarea[]         @relation("TareaCreador")
  tareasAprobadas Tarea[]         @relation("TareaAprobador")
  tareasAsignadas TareaAsignado[]
  adjuntosSubidos TareaAdjunto[]
  comentarios     TareaComentario[]
  guardias        GuardiaParticipante[]
  fichadas        Fichada[]

  @@index([destacamentoId])
  @@map("usuario")
}

/// Área del destacamento (Automotores, Materiales, Oficina, Edilicio, Suministros).
/// Modelada como tabla (no enum) para soportar variaciones entre destacamentos.
model Area {
  id             String   @id @default(cuid())
  nombre         String
  destacamentoId String
  createdAt      DateTime @default(now())

  destacamento Destacamento    @relation(fields: [destacamentoId], references: [id])
  asignaciones AsignacionRol[]
  tareas       Tarea[]

  @@unique([destacamentoId, nombre])
  @@index([destacamentoId])
  @@map("area")
}

/// Asignación de un rol a un usuario, con vigencia. Permite rotaciones y
/// mantiene el historial: vigenteHasta = null significa asignación actual.
/// Para ENCARGADO_AREA y MIEMBRO, areaId indica el área correspondiente.
model AsignacionRol {
  id           String    @id @default(cuid())
  usuarioId    String
  rol          RolTipo
  areaId       String? // requerido para roles de área; null para roles de dto
  vigenteDesde DateTime  @default(now())
  vigenteHasta DateTime? // null = vigente
  createdAt    DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  area    Area?   @relation(fields: [areaId], references: [id])

  @@index([usuarioId])
  @@index([areaId])
  @@map("asignacion_rol")
}

// ---------------------------------------------------------------------------
// Tareas (PRD §4.3)
// ---------------------------------------------------------------------------

enum Prioridad {
  ALTA
  MEDIA
  BAJA
}

/// Flujo: Pendiente → En revisión (requiere aprobación) → Completa.
enum EstadoTarea {
  PENDIENTE
  EN_REVISION
  COMPLETA
}

model Tarea {
  id             String      @id @default(cuid())
  titulo         String
  descripcion    String?
  prioridad      Prioridad   @default(MEDIA)
  estado         EstadoTarea @default(PENDIENTE)
  fechaLimite    DateTime?
  destacamentoId String
  areaId         String? // null = tarea general del destacamento
  creadorId      String
  aprobadorId    String? // quién dio el visto bueno
  aprobadaEn     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  destacamento Destacamento    @relation(fields: [destacamentoId], references: [id])
  area         Area?           @relation(fields: [areaId], references: [id])
  creador      Usuario         @relation("TareaCreador", fields: [creadorId], references: [id])
  aprobador    Usuario?        @relation("TareaAprobador", fields: [aprobadorId], references: [id])
  asignados    TareaAsignado[]
  adjuntos     TareaAdjunto[]
  comentarios  TareaComentario[]

  @@index([destacamentoId])
  @@index([areaId])
  @@map("tarea")
}

/// Responsables de una tarea (puede haber varios).
model TareaAsignado {
  id        String @id @default(cuid())
  tareaId   String
  usuarioId String

  tarea   Tarea   @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([tareaId, usuarioId])
  @@index([usuarioId])
  @@map("tarea_asignado")
}

/// Evidencia fotográfica de la tarea (path en el bucket de Supabase Storage).
model TareaAdjunto {
  id          String   @id @default(cuid())
  tareaId     String
  path        String
  subidoPorId String
  createdAt   DateTime @default(now())

  tarea    Tarea   @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  subidoPor Usuario @relation(fields: [subidoPorId], references: [id])

  @@index([tareaId])
  @@map("tarea_adjunto")
}

/// Comentarios de seguimiento de una tarea (bitácora: avances, bloqueos, etc.).
model TareaComentario {
  id        String   @id @default(cuid())
  tareaId   String
  autorId   String
  texto     String
  createdAt DateTime @default(now())

  tarea Tarea   @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  autor Usuario @relation(fields: [autorId], references: [id])

  @@index([tareaId])
  @@map("tarea_comentario")
}

// ---------------------------------------------------------------------------
// Guardias (PRD §4.4)
// ---------------------------------------------------------------------------

enum TipoGuardia {
  INTERNA // del destacamento, 22:00 a 08:00, puede haber más de una persona
  CUARTELERO // externo (depende de Lomas), 24 hs de 07:00 a 07:00; en el MVP solo nombre
}

model Guardia {
  id               String      @id @default(cuid())
  destacamentoId   String
  tipo             TipoGuardia
  fecha            DateTime // día de la guardia (la hora se deriva del tipo)
  cuarteleroNombre String? // solo para CUARTELERO (externo, sin usuario en el MVP)
  notas            String?
  createdAt        DateTime    @default(now())

  destacamento  Destacamento          @relation(fields: [destacamentoId], references: [id])
  participantes GuardiaParticipante[]
  intercambios  IntercambioGuardia[]
  fichadas      Fichada[]

  @@index([destacamentoId, fecha])
  @@map("guardia")
}

/// Participante de una guardia interna (puede haber varios).
model GuardiaParticipante {
  id        String @id @default(cuid())
  guardiaId String
  usuarioId String

  guardia Guardia @relation(fields: [guardiaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([guardiaId, usuarioId])
  @@index([usuarioId])
  @@map("guardia_participante")
}

/// Intercambio/cobertura de una guardia entre pares (PRD §4.4). Sin aprobación;
/// queda registrado. Se guardan los nombres como snapshot para el historial.
model IntercambioGuardia {
  id          String   @id @default(cuid())
  guardiaId   String
  deUsuarioId String
  aUsuarioId  String
  deNombre    String
  aNombre     String
  createdAt   DateTime @default(now())

  guardia Guardia @relation(fields: [guardiaId], references: [id], onDelete: Cascade)

  @@index([guardiaId])
  @@map("intercambio_guardia")
}

// ---------------------------------------------------------------------------
// Fichado (PRD §4.5)
// ---------------------------------------------------------------------------

enum TipoFichada {
  ENTRADA
  SALIDA
}

model Fichada {
  id             String      @id @default(cuid())
  usuarioId      String
  guardiaId      String? // guardia asociada (si le tocaba)
  destacamentoId String
  tipo           TipoFichada
  momento        DateTime    @default(now())
  noProgramada   Boolean     @default(false) // fichó una guardia que no le tocaba

  usuario Usuario  @relation(fields: [usuarioId], references: [id])
  guardia Guardia? @relation(fields: [guardiaId], references: [id])

  @@index([destacamentoId, momento])
  @@index([usuarioId])
  @@map("fichada")
}
